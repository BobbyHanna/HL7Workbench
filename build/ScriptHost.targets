<Project>
  <PropertyGroup>
    <_WorkbenchWorkerBuildRoot>$(MSBuildThisFileDirectory)../src/HL7Workbench.ScriptHost/bin/$(Configuration)/net10.0/$(RuntimeIdentifier)/</_WorkbenchWorkerBuildRoot>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep scripting/execution dependencies in the worker directory; Desktop uses compiler-only Roslyn for editor colors. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/HL7Workbench.ScriptHost/HL7Workbench.ScriptHost.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyScriptHost" AfterTargets="Build">
    <ItemGroup>
      <!-- Copy this target's root files and satellites, not unrelated RID/publish trees. -->
      <_ScriptHostFiles Include="$(_WorkbenchWorkerBuildRoot)*;$(_WorkbenchWorkerBuildRoot)**/*.resources.dll"
        Exclude="$(_WorkbenchWorkerBuildRoot)win-*/**;$(_WorkbenchWorkerBuildRoot)linux-*/**;$(_WorkbenchWorkerBuildRoot)osx-*/**;$(_WorkbenchWorkerBuildRoot)*/*/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_ScriptHostFiles)" DestinationFiles="@(_ScriptHostFiles->'$(TargetDir)ScriptHost/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <!-- The portable candidate orchestrator publishes a complete self-contained
       worker separately; a framework-dependent Build tree cannot stand in for it. -->
  <Target Name="PublishScriptHost" BeforeTargets="ComputeFilesToPublish" Condition="'$(PublishScriptHostSeparately)' != 'true'">
    <ItemGroup>
      <_PublishScriptHost Include="$(_WorkbenchWorkerBuildRoot)*;$(_WorkbenchWorkerBuildRoot)**/*.resources.dll"
        Exclude="$(_WorkbenchWorkerBuildRoot)win-*/**;$(_WorkbenchWorkerBuildRoot)linux-*/**;$(_WorkbenchWorkerBuildRoot)osx-*/**;$(_WorkbenchWorkerBuildRoot)*/*/**" />
      <ResolvedFileToPublish Include="@(_PublishScriptHost)">
        <RelativePath>ScriptHost/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
