<Project>
  <PropertyGroup>
    <_QueryHostBuildRoot Condition="'$(_QueryHostBuildRoot)' == ''">$(MSBuildThisFileDirectory)../src/HL7Workbench.QueryHost/bin/$(Configuration)/net10.0/</_QueryHostBuildRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/HL7Workbench.QueryHost/HL7Workbench.QueryHost.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyQueryHost" AfterTargets="Build">
    <ItemGroup>
      <_QueryHostFiles Include="$(_QueryHostBuildRoot)**/*" Exclude="$(_QueryHostBuildRoot)**/publish/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_QueryHostFiles)" DestinationFiles="@(_QueryHostFiles->'$(TargetDir)QueryHost/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
