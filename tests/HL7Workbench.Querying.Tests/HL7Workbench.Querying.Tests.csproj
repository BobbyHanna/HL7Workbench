<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable>
    <_QueryHostBuildRoot Condition="'$(_QueryHostBuildRoot)' == ''">$(MSBuildThisFileDirectory)../../src/HL7Workbench.QueryHost/bin/$(Configuration)/net10.0/</_QueryHostBuildRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/HL7Workbench.Querying/HL7Workbench.Querying.csproj" />
    <ProjectReference Include="../../src/HL7Workbench.QueryHost/HL7Workbench.QueryHost.csproj" ReferenceOutputAssembly="false" Private="false" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <Target Name="CopyQueryHostForTests" AfterTargets="Build">
    <ItemGroup>
      <_QueryHostFiles Include="$(_QueryHostBuildRoot)**/*" Exclude="$(_QueryHostBuildRoot)**/publish/**" />
    </ItemGroup>
    <Copy SourceFiles="@(_QueryHostFiles)" DestinationFiles="@(_QueryHostFiles->'$(TargetDir)QueryHost/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
