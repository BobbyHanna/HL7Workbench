<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets/workbench.ico</ApplicationIcon>
    <Product>Message Workbench</Product>
    <AssemblyTitle>Message Workbench</AssemblyTitle>
    <Description>A local-first healthcare interoperability development tool.</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Avalonia rewrites symbol-bearing PE files after Csc and recreates CodeView
         from the physical PDB location, outside Roslyn's PathMap. Match portable
         publishing here so ordinary Release output is also safe for warm reuse. -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><AvaloniaResource Include="Assets/**" /></ItemGroup>
  <ItemGroup>
    <!-- Compiler-only editor colors and documentation assistance; execution stays in ScriptHost. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <ProjectReference Include="../HL7Workbench.Core/HL7Workbench.Core.csproj" />
    <ProjectReference Include="../HL7Workbench.Workspace/HL7Workbench.Workspace.csproj" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Suppress the transitive build-time telemetry task. -->
    <PackageReference Include="Avalonia.BuildServices" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="../../build/ScriptHost.targets" />
  <Import Project="../../build/QueryHost.targets" />
  <ItemGroup><InternalsVisibleTo Include="HL7Workbench.Desktop.Tests" /></ItemGroup>
</Project>
