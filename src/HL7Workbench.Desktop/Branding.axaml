<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <WindowIcon x:Key="WorkbenchWindowIcon">avares://HL7Workbench.Desktop/Assets/workbench.ico</WindowIcon>
  </Styles.Resources>
  <!-- Include derived windows (including Dock hosts) without per-dialog assignments. -->
  <Style Selector=":is(Window)">
    <Setter Property="Icon" Value="{StaticResource WorkbenchWindowIcon}" />
  </Style>
</Styles>
