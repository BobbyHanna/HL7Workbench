<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HL7Workbench.Desktop.MainWindow"
        xmlns:dock="using:Dock.Avalonia.Controls"
        xmlns:local="using:HL7Workbench.Desktop"
        Title="{x:Static local:ProductBranding.Name}" Width="1200" Height="800"
        MinWidth="720" MinHeight="480">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu x:Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_Open File…" Click="OpenFile" />
        <MenuItem Header="_Save" Click="SaveDocument" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _As…" Click="SaveDocumentAs" InputGesture="Ctrl+Shift+S" />
        <MenuItem x:Name="AddMessageMenu" Header="_Add Message" />
        <MenuItem x:Name="GenerateMessagesMenu" Header="_Generate Messages…" />
        <MenuItem x:Name="ImportSyntheticPatientsMenu" Header="Import Patient _FHIR…" Click="ShowSyntheticPatients" />
      </MenuItem>
      <MenuItem Header="_Settings">
        <MenuItem Header="_Preferences…" Click="ShowPreferences" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_HL7 Inspection">
          <MenuItem Header="_Segment Navigator" Click="ShowNavigator" ToolTip.Tip="Show segments in the active message" />
          <MenuItem Header="_Field Inspector" Click="ShowFields" ToolTip.Tip="Inspect structural values in the selected segment" />
          <MenuItem Header="Message _Browser" Click="ShowBrowser" />
          <MenuItem Header="Full _Source Viewer" Click="ShowRaw" ToolTip.Tip="View complete original HL7 message" />
          <MenuItem x:Name="FindMessagesMenu" Header="_Find Messages" InputGesture="Ctrl+F" ToolTip.Tip="Open Find Messages and focus the search value (Ctrl+F)" AutomationProperties.Name="Find Messages" />
        </MenuItem>
        <MenuItem Header="_Data &amp; Query">
          <MenuItem x:Name="SqlQueryMenu" Header="S_QL Query" Click="ShowSqlQuery" ToolTip.Tip="Run local read-only SQL over loaded HL7, report to CSV or open matching messages" />
          <MenuItem x:Name="FieldExtractionMenu" Header="Field E_xtraction" Click="ShowFieldExtraction" ToolTip.Tip="Extract fields into a read-only table and CSV" />
          <MenuItem Header="Script _Editor" Click="ShowScripts" ToolTip.Tip="Create, save and run trusted local C# scripts" />
        </MenuItem>
        <MenuItem Header="_Connectivity &amp; Testing">
          <MenuItem Header="_Connection Manager" Click="ShowConnections" />
          <MenuItem Header="_MLLP Listener" Click="ShowListener" />
          <MenuItem Header="Batch _Transmission" Click="ShowBatchTransmission" />
          <MenuItem Header="Controlled _Load Testing" Click="ShowLoadTesting" />
        </MenuItem>
        <MenuItem Header="_Reports">
          <MenuItem Header="_Generation Report" Click="ShowGenerationReport" ToolTip.Tip="Review the selected document's synthetic HL7 or FHIR generation report" />
          <MenuItem Header="_De-identification Report" Click="ShowDeidentificationReport" ToolTip.Tip="Review the selected output's de-identification execution and findings" />
        </MenuItem>
        <Separator />
        <MenuItem x:Name="SyntheticPatientsMenu" Header="FHIR Patient _Workspace" Click="ShowSyntheticPatients" ToolTip.Tip="Import local FHIR R4, inspect patient records and generate HL7" />
        <MenuItem Header="_Activity Log" Click="ShowActivity" ToolTip.Tip="Show session operation history, warnings and errors" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="DocumentationMenu" Header="_Documentation" Click="ShowDocumentation" />
        <MenuItem x:Name="ScriptApiReferenceMenu" Header="Script _API Reference" Click="ShowScriptApiReference" />
        <MenuItem x:Name="AboutMenu" Header="_About Message Workbench…" Click="ShowAbout" />
      </MenuItem>
    </Menu>
    <ContentControl x:Name="RibbonHost" Grid.Row="1" />
    <dock:DockControl x:Name="WorkspaceDock" Grid.Row="2" />
    <DockPanel Grid.Row="3">
      <ContentControl x:Name="ActivityIndicatorHost" DockPanel.Dock="Right" />
      <Button x:Name="CancelOpening" DockPanel.Dock="Right" Content="Cancel opening" Click="CancelOpen" IsVisible="False" ToolTip.Tip="Cancel opening and indexing the selected files" />
      <TextBlock x:Name="Status" Margin="8,4" Text="Message Workbench • use File → Open File" />
    </DockPanel>
  </Grid>
</Window>
